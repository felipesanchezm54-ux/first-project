# ─── Sitio ─────────────────────────────────────────────────────────────
# URL pública del sitio (canonical, sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL="https://nexo.example"

# ─── Base de datos ─────────────────────────────────────────────────────
# SQLite local. Para PostgreSQL cambia el provider en prisma/schema.prisma
# y usa una URL tipo postgresql://usuario:clave@host:5432/nexo
DATABASE_URL="file:./nexo.db"

# ─── Sesión del panel de clientes ──────────────────────────────────────
# Cadena aleatoria de al menos 32 caracteres (openssl rand -base64 32).
AUTH_SECRET="cambia-esta-cadena-por-una-aleatoria-de-32-caracteres"

# ─── Correo del formulario de contacto (opcional) ──────────────────────
# Sin RESEND_API_KEY el lead se guarda igual en la base y el formulario
# muestra éxito: la demo no se rompe.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="NEXO <hola@nexo.example>"
CONTACT_TO_EMAIL="hola@nexo.example"

# ─── Vera, agente de IA (opcional) ─────────────────────────────────────
# Sin clave, Vera responde con respuestas predefinidas por intención.
ANTHROPIC_API_KEY=""

# ─── Analítica (solo se carga si el usuario acepta cookies) ────────────
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
